<!ELEMENT table (name, columns, primary_key?, foreign_key*, unique*, check*)>
<!ELEMENT name (#PCDATA)>
<!ELEMENT foreign_key (#PCDATA)>
<!ELEMENT columns (column+)>
<!ELEMENT column (name, type, primary_key?, unique?, not_null?, default?, check?)>
<!ELEMENT type (#PCDATA)>
<!ELEMENT primary_key (#PCDATA)>
<!ELEMENT unique (#PCDATA)>
<!ELEMENT not_null (#PCDATA)>
<!ELEMENT default (#PCDATA)>
<!ELEMENT check (#PCDATA)>

<!ATTLIST check column_name CDATA #REQUIRED>
<!ATTLIST check condition CDATA #REQUIRED>
<!ATTLIST foreign_key column_name CDATA #REQUIRED>
<!ATTLIST foreign_key referenced_table CDATA #REQUIRED>
<!ATTLIST foreign_key referenced_column CDATA #REQUIRED>
