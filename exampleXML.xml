<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE table SYSTEM "exampleDTD.dtd">

<table>
    <name>USERS</name>
    <columns>
        <column>
            <name>ID</name>
            <type>NUMBER</type>
            <primary_key></primary_key>
            <unique>TRUE</unique>
            <not_null>TRUE</not_null>
            <default>NULL</default>
            <check column_name="ID" condition="ID > 0"/>
        </column>
        <column>
            <name>USERNAME</name>
            <type>STRING</type>
            <check column_name="USERNAME" condition="LENGTH(USERNAME) > 0"/>
        </column>
        <column>
            <name>EMAIL</name>
            <type>STRING</type>
            <default>NULL</default>
        </column>
    </columns>
    <primary_key>USERNAME</primary_key>
    <foreign_key column_name="EMAIL" referenced_table="USERNAME" referenced_column="USERNAME"/>
    <unique>EMAIL</unique>
    <check column_name="ID" condition="ID > 0"/>
</table>